<mujoco model="tek5_pick_and_place_phase2">
    <include file="so101_tek5.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <global azimuth="160" elevation="-20" offwidth="1280" offheight="720" />
    </visual>

    <default>
        <default class="pickup_visual_red">
            <geom type="mesh" mesh="pickup_object" material="red" contype="0" conaffinity="0"
                group="2" density="0" />
        </default>
        <default class="pickup_visual_blue">
            <geom type="mesh" mesh="pickup_object" material="blue" contype="0" conaffinity="0"
                group="2" density="0" />
        </default>
        <default class="pickup_collision">
            <geom type="mesh" mesh="pickup_object_collision" group="3" mass="0.005"
                friction="1.0 0.005 0.0001" />
        </default>
    </default>

    <asset>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge"
            rgb1="0.25 0.25 0.28" rgb2="0.18 0.18 0.20" markrgb="0.6 0.6 0.6"
            width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true"
            texrepeat="5 5" reflectance="0.1" />

        <!-- Cube materials -->
        <material name="red" rgba="0.80 0.05 0.22 1" specular="0.3" shininess="0.3" />
        <material name="blue" rgba="0.10 0.30 0.85 1" specular="0.3" shininess="0.3" />

        <!-- Drop box materials -->
        <material name="red_box_mat" rgba="0.65 0.10 0.15 1" />
        <material name="blue_box_mat" rgba="0.10 0.25 0.65 1" />

        <mesh name="pickup_object" file="hollow_cube_rhombus_50mm.stl" scale="0.001 0.001 0.001" />
        <mesh name="pickup_object_collision" file="pickup_object_collision_octant.stl"
            scale="0.001 0.001 0.001" />
    </asset>

    <worldbody>
        <light pos="0 0 2.5" dir="0 0 -1" directional="true" />
        <light pos="0.5 0.5 1.5" dir="-0.3 -0.3 -1" diffuse="0.4 0.4 0.4" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- Red cube (keeps original name for compatibility) -->
        <body name="pickup_object" pos="0.25 0.05 0.025">
            <freejoint name="pickup_object_free" />
            <geom name="pickup_object_visual" class="pickup_visual_red" pos="0 0 -0.025" />
            <geom class="pickup_collision" quat="1 0 0 0" />
            <geom class="pickup_collision" quat="0.70711 0 0 0.70711" />
            <geom class="pickup_collision" quat="0 0 0 1" />
            <geom class="pickup_collision" quat="0.70711 0 0 -0.70711" />
            <geom class="pickup_collision" quat="0 1 0 0" />
            <geom class="pickup_collision" quat="0 0.70711 0.70711 0" />
            <geom class="pickup_collision" quat="0 0 1 0" />
            <geom class="pickup_collision" quat="0 0.70711 -0.70711 0" />
        </body>

        <!-- Blue cube -->
        <body name="pickup_object_blue" pos="0.25 -0.05 0.025">
            <freejoint name="pickup_object_blue_free" />
            <geom name="pickup_object_blue_visual" class="pickup_visual_blue" pos="0 0 -0.025" />
            <geom class="pickup_collision" quat="1 0 0 0" />
            <geom class="pickup_collision" quat="0.70711 0 0 0.70711" />
            <geom class="pickup_collision" quat="0 0 0 1" />
            <geom class="pickup_collision" quat="0.70711 0 0 -0.70711" />
            <geom class="pickup_collision" quat="0 1 0 0" />
            <geom class="pickup_collision" quat="0 0.70711 0.70711 0" />
            <geom class="pickup_collision" quat="0 0 1 0" />
            <geom class="pickup_collision" quat="0 0.70711 -0.70711 0" />
        </body>

        <!-- Static Red Drop Box -->
        <body name="drop_box" pos="0.05 -0.25 0.0">
            <geom type="box" size="0.05 0.05 0.002" pos="0 0 0.002" material="red_box_mat" />
            <geom type="box" size="0.05 0.002 0.025" pos="0 0.05 0.025" material="red_box_mat" />
            <geom type="box" size="0.05 0.002 0.025" pos="0 -0.05 0.025" material="red_box_mat" />
            <geom type="box" size="0.002 0.05 0.025" pos="0.05 0 0.025" material="red_box_mat" />
            <geom type="box" size="0.002 0.05 0.025" pos="-0.05 0 0.025" material="red_box_mat" />
        </body>

        <!-- Static Blue Drop Box (mirrored on the opposite side) -->
        <body name="drop_box_blue" pos="0.05 0.25 0.0">
            <geom type="box" size="0.05 0.05 0.002" pos="0 0 0.002" material="blue_box_mat" />
            <geom type="box" size="0.05 0.002 0.025" pos="0 0.05 0.025" material="blue_box_mat" />
            <geom type="box" size="0.05 0.002 0.025" pos="0 -0.05 0.025" material="blue_box_mat" />
            <geom type="box" size="0.002 0.05 0.025" pos="0.05 0 0.025" material="blue_box_mat" />
            <geom type="box" size="0.002 0.05 0.025" pos="-0.05 0 0.025" material="blue_box_mat" />
        </body>

        <camera name="external_cam" pos="0.55 0.35 0.35" xyaxes="-0.707 0.707 0 -0.354 -0.354 0.866"
            fovy="65" />
    </worldbody>
</mujoco>
