<mujoco model="tek5_pick_and_place">
    <include file="so101_tek5.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <global azimuth="160" elevation="-20" offwidth="1280" offheight="720" />
    </visual>

    <default>
        <!-- pickup_object: rendered with the full mesh, collisions with 8 convex pieces (one per
             octant of the cube, see scripts/make_pickup_object_collision.py) that leave the
             diamond tunnels open to the gripper. -->
        <default class="pickup_visual">
            <geom type="mesh" mesh="pickup_object" material="red" contype="0" conaffinity="0"
                group="2" density="0" />
        </default>
        <default class="pickup_collision">
            <geom type="mesh" mesh="pickup_object_collision" group="3" mass="0.005"
                friction="1.0 0.005 0.0001" />
        </default>
    </default>

    <asset>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge"
            rgb1="0.25 0.25 0.28" rgb2="0.18 0.18 0.20" markrgb="0.6 0.6 0.6"
            width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true"
            texrepeat="5 5" reflectance="0.1" />
        <!-- Hue and saturation of the printed PLA as seen by the real camera (OpenCV HSV ~168, 185) -->
        <material name="red" rgba="0.80 0.05 0.22 1" specular="0.3" shininess="0.3" />
        <material name="box_mat" rgba="0.35 0.20 0.12 1" />
        <mesh name="pickup_object" file="hollow_cube_rhombus_50mm.stl" scale="0.001 0.001 0.001" />
        <mesh name="pickup_object_collision" file="pickup_object_collision_octant.stl"
            scale="0.001 0.001 0.001" />
    </asset>

    <worldbody>
        <light pos="0 0 2.5" dir="0 0 -1" directional="true" />
        <light pos="0.5 0.5 1.5" dir="-0.3 -0.3 -1" diffuse="0.4 0.4 0.4" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- pickup_object: 5 cm red cube (rounded edges) pierced by 3 diamond tunnels, like the
             printed part (hollow_cube_rhombus_50mm.stl, origin at the center of the bottom face).
             Free body, randomizable via qpos, origin at the center of the cube, mass 40 g. -->
        <body name="pickup_object" pos="0.25 0.05 0.025">
            <freejoint name="pickup_object_free" />
            <geom name="pickup_object_visual" class="pickup_visual" pos="0 0 -0.025" />
            <geom class="pickup_collision" quat="1 0 0 0" />
            <geom class="pickup_collision" quat="0.70711 0 0 0.70711" />
            <geom class="pickup_collision" quat="0 0 0 1" />
            <geom class="pickup_collision" quat="0.70711 0 0 -0.70711" />
            <geom class="pickup_collision" quat="0 1 0 0" />
            <geom class="pickup_collision" quat="0 0.70711 0.70711 0" />
            <geom class="pickup_collision" quat="0 0 1 0" />
            <geom class="pickup_collision" quat="0 0.70711 -0.70711 0" />
        </body>

        <!-- Drop box -->
        <body name="drop_box" pos="0.05 -0.25 0.0">
            <geom type="box" size="0.05 0.05 0.002" pos="0 0 0.002" material="box_mat" />
            <geom type="box" size="0.05 0.002 0.025" pos="0 0.05 0.025" material="box_mat" />
            <geom type="box" size="0.05 0.002 0.025" pos="0 -0.05 0.025" material="box_mat" />
            <geom type="box" size="0.002 0.05 0.025" pos="0.05 0 0.025" material="box_mat" />
            <geom type="box" size="0.002 0.05 0.025" pos="-0.05 0 0.025" material="box_mat" />
        </body>

        <!-- Fixed external camera (eye-to-hand), KNOWN pose: this is the reference
             camera->world TF. Looks at the workspace from above/the side. -->
        <camera name="external_cam" pos="0.45 0.35 0.35" xyaxes="-0.707 0.707 0 -0.354 -0.354 0.866"
            fovy="52" />
    </worldbody>
</mujoco>
